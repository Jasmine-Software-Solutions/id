@import app.Env
@import java.util.UUID

@param email: String
@param magicLinkId: UUID
@param magicLinkToken: String

<div id="modal"
     class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
    <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
        <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
            Sent your magic link
        </h1>

        <div id="form-error"></div>

        <p class="text-sm font-light text-gray-500 dark:text-gray-400">
            Open your mail, then open the link sent by <span class="text-pink-400 font-bold">${Env.SMTP_EMAIL}</span>.
            Be sure to check your spam folder.
        </p>

        <form class="space-y-4 md:space-y-6" hx-post="/login" hx-swap="none" hx-trigger="every 2s">
            <!--suppress HtmlFormInputWithoutLabel -->
            <input class="hidden" id="email" name="email" value="${email}"/>
            <input class="hidden" id="magic_link_id" name="magic_link_id" value="${magicLinkId.toString()}"/>
            <input class="hidden" id="magic_link_token" name="magic_link_token" value="${magicLinkToken}"/>
        </form>

        <p class="text-sm font-light text-gray-500 dark:text-gray-400">
            I didn't get anything, <a href="/login?email=${email}" class="cursor-pointer font-medium text-primary-600 hover:underline dark:text-primary-500">send me another email</a> or <a href="/login?email=${email}&password=true" class="cursor-pointer font-medium text-primary-600 hover:underline dark:text-primary-500">try with my password</a>.
        </p>
    </div>
</div>
