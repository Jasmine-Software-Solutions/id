@import com.jasminesoftwaresolutions.id.domain.models.SignedValue
@import java.util.UUID

@param flowId: UUID
@param request: SignedValue<*>

@param error: Boolean = false

<div id="modal" class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
    <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
        <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
            Enter your verification code
        </h1>

        @if (error)
            @template.components.alert(detail = "The code you have entered is invalid.")
        @endif

        <p class="text-sm font-light text-gray-500 dark:text-gray-400">
            Open <span class="text-pink-400 font-bold">Google Authenticator</span> on your phone, then enter the six digit code for <span class="text-primary-600">Jasmine ID</span>.
        </p>

        <form class="space-y-4 md:space-y-6" hx-post="/login/next" hx-select="#modal" hx-target="#modal" hx-swap="outerHTML">
            <div class="hidden">
                <input type="hidden" name="flow_id" value="${flowId.toString()}">
                <input type="hidden" name="request" value="${request.toString()}">
            </div>

            <div>
                <!--suppress HtmlFormInputWithoutLabel -->
                <input name="response.totp" id="otp" class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" placeholder="123-456" required="" autofocus>
            </div>

            <button type="submit" class="w-full text-white bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                Sign in
            </button>
        </form>
    </div>
</div>