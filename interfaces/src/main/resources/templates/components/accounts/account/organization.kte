@import com.jasminesoftwaresolutions.id.domain.models.account.IAccount
@import com.jasminesoftwaresolutions.id.domain.models.AttachmentType
@import com.jasminesoftwaresolutions.id.domain.models.tenant.ITenantMembership

@param account: IAccount
@param membership: ITenantMembership
@param isSelf: Boolean

!{ val action = if (isSelf)
         "/account/memberships/unassign"
     else "/accounts/${account.id.toString()}/memberships/unassign"
}
!{ val membershipName = membership.team?.name ?: membership.organization?.name ?: membership.tenant?.name ?: "Membership" }
!{ val membershipType = when (membership.attachment.type) {
         AttachmentType.TENANT -> "Tenant"
         AttachmentType.ORGANIZATION -> "Organization"
         AttachmentType.TEAM -> "Team"
         else -> "Membership"
     }
}

<div class="flex items-center justify-between group">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-surface-container-high rounded-lg flex items-center justify-center font-bold text-primary">${membershipName.first()}</div>
        <div>
            <p class="text-body-md font-bold">${membershipName}</p>
            <p class="text-label-sm text-secondary">${membershipType}</p>
        </div>
    </div>
    @if (membership.attachment.type == AttachmentType.TENANT && membership.tenant != null)
        <form method="post" action="${action}">
            <input type="hidden" name="tenant_id" value="${membership.tenant!!.id.toString()}">
            <button class="p-2 hover:bg-slate-50 rounded-lg transition-colors text-error text-label-sm" type="submit">
                @if (isSelf)
                    Leave
                @else
                    Remove
                @endif
            </button>
        </form>
    @endif
</div>
