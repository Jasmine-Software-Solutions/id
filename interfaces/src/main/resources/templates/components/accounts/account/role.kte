@import com.jasminesoftwaresolutions.id.domain.models.account.IAccount
@import com.jasminesoftwaresolutions.id.domain.models.authorization.IRole

@param account: IAccount
@param role: IRole
@param assigned: Boolean
@param allowUpdateRoles: Boolean
@param isSelf: Boolean

!{ val assignAction = if (isSelf)
         "/account/roles/assign"
     else "/accounts/${account.id.toString()}/roles/assign"
}
!{ val unassignAction = if (isSelf)
         "/account/roles/unassign"
     else "/accounts/${account.id.toString()}/roles/unassign"
}

<div>
    @if (allowUpdateRoles)
        <form method="post" action="${if (assigned) unassignAction else assignAction}">
            <input type="hidden" name="role_id" value="${role.id}" />

            <button type="submit" class="w-full p-4 ${if (assigned) "bg-slate-50" else ""} rounded-xl border border-slate-100 flex items-center justify-between">
                <div>
                    <p class="text-body-md font-bold">${role.name}</p>
                    <p class="text-label-sm text-secondary text-left">${role.description}</p>
                </div>

                @if (assigned)
                    <span class="material-symbols-outlined text-primary" data-icon="check_circle" data-weight="fill" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                @endif
            </button>
        </form>
    @else
        <div class="w-full p-4 ${if (assigned) "bg-slate-50" else ""} rounded-xl border border-slate-100 flex items-center justify-between">
            <div>
                <p class="text-body-md font-bold">${role.name}</p>
                <p class="text-label-sm text-secondary text-left">${role.description}</p>
            </div>

            @if (assigned)
                <span class="material-symbols-outlined text-primary" data-icon="check_circle" data-weight="fill" style="font-variation-settings: 'FILL' 1;">check_circle</span>
            @endif
        </div>
    @endif
</div>