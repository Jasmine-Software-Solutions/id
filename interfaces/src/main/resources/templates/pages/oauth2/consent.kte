@import com.jasminesoftwaresolutions.id.domain.models.client.IClient
@import com.jasminesoftwaresolutions.id.domain.models.account.IAccount
@import com.jasminesoftwaresolutions.id.domain.models.tenant.ITenant
@import com.jasminesoftwaresolutions.id.domain.models.authorization.IScope

@param client: IClient
@param account: IAccount
@param tenant: ITenant?
@param scopes: List<IScope>

!{
    val sortedScopes = scopes.stream()
        .sorted(
            compareByDescending<IScope> { it.client?.id == client.id }
                .thenBy { it.client?.name ?: "" }
                .thenBy { it.description.lowercase() }
        )
        .toList();

    val tenantScopes = sortedScopes.stream()
        .filter { it.isByTenant }
        .toList();

    val platformScopes = sortedScopes.stream()
        .filter { !it.isByTenant }
        .toList();
}

<head>
    @template.scripts.htmx()
    @template.scripts.tailwind()

    <title>Jasmine Software Solutions</title>
</head>
<body>
<section class="bg-gray-50 dark:bg-gray-900">
    <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
        <div class="flex items-center mb-6 text-2xl font-semibold text-gray-900 dark:text-white">
            <img class="w-8 h-8 mr-2" src="/fish.svg" alt="logo">
            Jasmine Software Solutions
        </div>
        <div id="modal" class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
            <div class="p-6 space-y-6 md:space-y-6 sm:p-8">
                <div>
                    <h1 class="text-xl font-bold text-gray-900 dark:text-white">
                        Authorize ${client.name}
                    </h1>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                        Signed in as <span class="font-medium">${account.firstName} ${account.lastName}</span>
                    </p>
                </div>

                <div class="text-sm text-gray-700 dark:text-gray-300">
                    <p>
                        ${client.name} can perform the same actions that you can, if you permit it now. Please review the privileges you grant by clicking "Approve."
                    </p>
                </div>

                @if (tenant != null && !tenantScopes.isEmpty())
                    <div>
                        <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">
                            In ${tenant.name}:
                        </h2>
                        <ul class="space-y-2">
                            @for (scope in tenantScopes)
                                <li class="flex items-start space-x-2">
                                    <input type="checkbox" checked disabled
                                           class="mt-1 w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded">
                                    <span class="text-sm text-gray-700 dark:text-gray-300">
                                        @if (scope.client != null)
                                            <span class="font-medium">In ${scope.client!!.name}<span class="text-gray-500 dark:text-gray-400">:</span></span>
                                        @endif

                                        ${scope.description}
                                    </span>
                                </li>
                            @endfor
                        </ul>
                    </div>
                @endif

                @if (!platformScopes.isEmpty())
                    <div>
                        <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">
                            Throughout the platform:
                        </h2>
                        <ul class="space-y-2">
                            @for (scope in platformScopes)
                                <li class="flex items-start space-x-2">
                                    <input type="checkbox" checked disabled
                                           class="mt-1 w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded">
                                    <span class="text-sm text-gray-700 dark:text-gray-300">
                                        @if (scope.client != null)
                                            <span class="font-medium">${scope.client!!.name}</span>
                                            <span class="text-gray-500 dark:text-gray-400">:</span>
                                        @endif

                                        ${scope.description}
                                    </span>
                                </li>
                            @endfor
                        </ul>
                    </div>
                @endif

                <form class="pt-4 flex flex-col justify-between gap-4" hx-post="">
                    <button type="submit"
                            class="w-full text-white bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                        Approve
                    </button>

                    <button hx-get="/" hx-select="body" hx-target="body"
                            class="w-full focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white">
                        Not Now
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
</body>
