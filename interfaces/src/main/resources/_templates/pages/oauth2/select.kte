@import app.infrastructure.models.account.Account
@import app.infrastructure.models.tenant.Tenant

@param account: Account
@param tenants: List<Tenant>

<head>
    @template.scripts.htmx()
    @template.scripts.tailwind()

    <title>Jasmine Software Solutions</title>
</head>
<body>
<section class="bg-gray-50 dark:bg-gray-900">
    <div id="modal" class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
        <div class="flex items-center mb-6 text-2xl font-semibold text-gray-900 dark:text-white">
            <img class="w-8 h-8 mr-2" src="/fish.svg" alt="logo">
            Jasmine Software Solutions
        </div>
        <div class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
            <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
                    Select your organization
                </h1>

                <div class="flex flex-col">
                    @for(tenant in tenants)
                        <form hx-post="/oauth2/select">
                            <input name="tenant" id="tenant" type="hidden" value="${tenant.id?.toString()}"/>

                            <button type="submit" class="w-full text-black hover:bg-opacity-20 hover:bg-primary-700 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium text-sm px-5 py-2.5 text-center  dark:hover:bg-primary-700 dark:focus:ring-primary-800 dark:hover:bg-opacity-20">
                                ${tenant.name}
                            </button>
                        </form>
                    @endfor
                </div>
            </div>
        </div>
    </div>
</section>
</body>