@import app.application.Env

@param accountEmail: String
@param token: String

<head>
    @template.scripts.htmx()
    @template.scripts.tailwind()

    <title>Jasmine Software Solutions</title>
</head>
<body>
<section class="bg-gray-50 dark:bg-gray-900">
    <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
        <div class="flex items-center mb-6 text-2xl font-semibold text-gray-900 dark:text-white">
            <img class="w-8 h-8 mr-2" src="/fish.svg" alt="logo">
            Jasmine Software Solutions
        </div>
        <div id="modal"
             class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
            <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
                    Approve sign-in request?
                </h1>

                <p class="text-sm font-light text-gray-500 dark:text-gray-400">
                    We received a request to sign in to <span class="font-medium text-gray-900 dark:text-white">${accountEmail}</span>.
                    If this was you, allow the sign-in. If not, deny the request.
                </p>

                <form class="space-y-4 md:space-y-6" method="post" action="/magic_links/${token}">
                    <button type="submit" name="decision" value="allow"
                            class="w-full text-white bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                        Approve
                    </button>
                    <button type="submit" name="decision" value="deny"
                            class="w-full text-gray-900 bg-gray-100 hover:bg-gray-200 focus:ring-4 focus:outline-none focus:ring-gray-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 dark:focus:ring-gray-600">
                        Deny
                    </button>
                </form>

                <p class="text-xs font-light text-gray-500 dark:text-gray-400">
                    This link was sent to you by ${Env.SMTP_EMAIL}.
                </p>
            </div>
        </div>
    </div>
</section>
</body>
